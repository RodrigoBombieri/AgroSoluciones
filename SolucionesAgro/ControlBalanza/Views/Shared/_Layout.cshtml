@using ControlBalanza.Seguridad
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();

    string Activo(string ctrl, string? act = null) =>
        string.Equals(controlador, ctrl, StringComparison.OrdinalIgnoreCase) &&
        (act == null || string.Equals(accion, act, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    var esAdmin = User.IsInRole(Roles.Admin);
    var esEntrada = esAdmin || User.IsInRole(Roles.BalanzaEntrada);
    var esPlayon = esAdmin || User.IsInRole(Roles.Playon);
    var esSalida = esAdmin || User.IsInRole(Roles.BalanzaSalida);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgroLogix</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(autenticado ? "con-sidebar" : "sin-sidebar")">
    @if (autenticado)
    {
        <!-- Barra superior (solo móvil/tablet) -->
        <header class="topbar d-lg-none">
            <button class="btn btn-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Abrir menú">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <span class="topbar-brand">AgroLogix</span>
        </header>

        <aside id="sidebar" class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" aria-label="Menú principal">
            <div class="sidebar-brand">
                <span class="material-symbols-outlined brand-icon">scale</span>
                <div>
                    <div class="brand-name">AgroLogix</div>
                    <small>Control de balanza</small>
                </div>
                <button type="button" class="btn-close btn-close-white ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Cerrar"></button>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-item @Activo("Home", "Index")" asp-controller="Home" asp-action="Index">
                    <span class="material-symbols-outlined">dashboard</span> Inicio
                </a>

                <div class="nav-section">Operación</div>
                @if (esEntrada)
                {
                    <a class="nav-item @Activo("Pesajes", "Create")" asp-controller="Pesajes" asp-action="Create">
                        <span class="material-symbols-outlined">input</span> Balanza entrada
                    </a>
                }
                @if (esPlayon)
                {
                    <a class="nav-item @Activo("Home", "Playon")" asp-controller="Home" asp-action="Playon">
                        <span class="material-symbols-outlined">local_shipping</span> Playón / Descarga
                    </a>
                }
                @if (esSalida)
                {
                    <a class="nav-item @(Activo("Pesajes", "Salida") + Activo("Pesajes", "RegistrarSalida"))" asp-controller="Pesajes" asp-action="Salida">
                        <span class="material-symbols-outlined">output</span> Balanza salida
                    </a>
                }
                <a class="nav-item @Activo("Pesajes", "Index")" asp-controller="Pesajes" asp-action="Index">
                    <span class="material-symbols-outlined">warehouse</span> Camiones en planta
                </a>

                @if (esAdmin)
                {
                    <div class="nav-section">Administración</div>
                    <a class="nav-item @Activo("Reportes")" asp-controller="Reportes" asp-action="Index">
                        <span class="material-symbols-outlined">analytics</span> Reportes
                    </a>
                    <a class="nav-item @Activo("Proveedores")" asp-controller="Proveedores" asp-action="Index">
                        <span class="material-symbols-outlined">agriculture</span> Proveedores
                    </a>
                    <a class="nav-item @Activo("Productos")" asp-controller="Productos" asp-action="Index">
                        <span class="material-symbols-outlined">grass</span> Productos
                    </a>
                    <a class="nav-item @Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                        <span class="material-symbols-outlined">group</span> Usuarios
                    </a>
                }
            </nav>

            <div class="sidebar-user">
                <span class="material-symbols-outlined">account_circle</span>
                <div class="user-name" title="@User.Identity?.Name">@User.Identity?.Name</div>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
                    <button type="submit" class="btn btn-icon" title="Cerrar sesión" aria-label="Cerrar sesión">
                        <span class="material-symbols-outlined">logout</span>
                    </button>
                </form>
            </div>
        </aside>
    }

    <div class="app-content">
        <main role="main">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @exito
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year AgroLogix · Control de Balanza
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
