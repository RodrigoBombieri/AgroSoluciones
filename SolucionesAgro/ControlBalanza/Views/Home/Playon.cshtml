@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Playón / Descarga";
    // Genera la cookie antiforgery y el token que Angular manda en el header X-XSRF-TOKEN
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}

@section Head {
    <meta name="xsrf-token" content="@tokens.RequestToken" />
    <link rel="stylesheet" href="~/angular-app/browser/styles.css" asp-append-version="true" />
}

<!-- La app Angular (ClientApp) se monta acá. Para recompilarla: npm run build en ClientApp -->
<app-root>
    <div class="card-panel text-muted">Cargando panel del playón…</div>
</app-root>

@section Scripts {
    <script src="~/angular-app/browser/main.js" type="module" asp-append-version="true"></script>
}
