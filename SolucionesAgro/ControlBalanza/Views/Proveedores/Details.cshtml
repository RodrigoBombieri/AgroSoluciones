@model Proveedor
@{
    ViewData["Title"] = Model.RazonSocial;
}

<div class="page-header">
    <h1>@Model.RazonSocial</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Reportes" asp-action="Index" asp-route-ProveedorId="@Model.Id" class="btn btn-outline-primary">Ver pesajes</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    </div>
</div>

<div class="card-panel" style="max-width: 720px">
    <partial name="_Detalle" model="Model" />
</div>
<a asp-action="Index">← Volver al listado</a>
