@model Proveedor
@{
    ViewData["Title"] = "Eliminar proveedor";
    var cantidad = (int)(ViewData["CantidadPesajes"] ?? 0);
}

<div class="page-header"><h1>Eliminar proveedor</h1></div>

@if (cantidad > 0)
{
    <div class="alert alert-warning">Este proveedor tiene @cantidad pesaje(s) registrados y no se puede eliminar.</div>
}
else
{
    <div class="alert alert-danger">¿Seguro que querés eliminar este proveedor?</div>
}

<div class="card-panel" style="max-width: 720px">
    <partial name="_Detalle" model="Model" />
</div>

<form asp-action="Delete" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    @if (cantidad == 0)
    {
        <button type="submit" class="btn btn-danger">Eliminar</button>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</form>
