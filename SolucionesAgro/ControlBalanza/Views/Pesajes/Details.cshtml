@model Pesaje
@{
    ViewData["Title"] = "Pesaje " + Model.NumeroCPE;
}

<div class="page-header">
    <h1>Pesaje <span class="mono">@Model.NumeroCPE</span></h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (Model.Estado == EstadoPesaje.Completado)
        {
            <a asp-action="Ticket" asp-route-id="@Model.Id" class="btn btn-outline-primary"><span class="material-symbols-outlined">receipt_long</span> Ticket</a>
        }
        @if (Model.Estado == EstadoPesaje.ListoSalida && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.BalanzaSalida)))
        {
            <a asp-action="RegistrarSalida" asp-route-id="@Model.Id" class="btn btn-success">Pesar tara</a>
        }
        @if (User.IsInRole(Roles.Admin))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Corregir</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Eliminar</a>
        }
    </div>
</div>

@if (ViewBag.FueraDeTolerancia == true)
{
    <div class="alert alert-warning">
        La diferencia con lo declarado en la CPE supera la tolerancia de ±@(((double)ViewBag.Tolerancia).ToString("0.##"))%.
    </div>
}

<div class="card-panel">
    <partial name="_DetallePesaje" model="Model" />
</div>
