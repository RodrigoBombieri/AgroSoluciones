@model Pesaje

<div class="row g-4">
    <div class="col-lg-6">
        <dl class="row dl-compacta mb-0">
            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.NumeroCPE)</dt>
            <dd class="col-sm-7 mono">@Model.NumeroCPE</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Ctg)</dt>
            <dd class="col-sm-7 mono">@(Model.Ctg ?? "—")</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Estado)</dt>
            <dd class="col-sm-7"><span class="estado estado-@Model.Estado">@VistaHelpers.Estado(Model.Estado)</span></dd>

            <dt class="col-sm-5">Proveedor</dt>
            <dd class="col-sm-7">@Model.Proveedor?.RazonSocial <span class="mono">(@Model.Proveedor?.CUIT)</span></dd>

            <dt class="col-sm-5">Producto</dt>
            <dd class="col-sm-7">@Model.Producto?.Nombre @Model.Producto?.Variedad</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PatenteCamion)</dt>
            <dd class="col-sm-7 mono">@Model.PatenteCamion</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PatenteAcoplado)</dt>
            <dd class="col-sm-7 mono">@(Model.PatenteAcoplado ?? "—")</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.NombreChofer)</dt>
            <dd class="col-sm-7">@(Model.NombreChofer ?? "—")</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.SiloDestino)</dt>
            <dd class="col-sm-7">@(Model.SiloDestino ?? "—")</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Observaciones)</dt>
            <dd class="col-sm-7">@(Model.Observaciones ?? "—")</dd>
        </dl>
    </div>
    <div class="col-lg-6">
        <dl class="row dl-compacta mb-0">
            <dt class="col-sm-5">Kilos declarados</dt>
            <dd class="col-sm-7 mono">@VistaHelpers.Kg(Model.KilosDeclarados)</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PesoBruto)</dt>
            <dd class="col-sm-7 mono">@VistaHelpers.Kg(Model.PesoBruto)</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PesoTara)</dt>
            <dd class="col-sm-7 mono">@VistaHelpers.Kg(Model.PesoTara)</dd>

            <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PesoNeto)</dt>
            <dd class="col-sm-7 mono fw-bold">@VistaHelpers.Kg(Model.PesoNeto)</dd>

            <dt class="col-sm-5">Diferencia</dt>
            <dd class="col-sm-7 mono">
                @if (Model.DiferenciaKg.HasValue)
                {
                    <span class="@(ViewBag.FueraDeTolerancia == true ? "estado badge-alerta" : "")">
                        @Model.DiferenciaKg.Value.ToString("+#,0;-#,0;0") kg (@Model.DiferenciaPorcentaje?.ToString("+0.00;-0.00;0")%)
                    </span>
                }
                else { <text>—</text> }
            </dd>

            <dt class="col-sm-5">Entrada</dt>
            <dd class="col-sm-7">@VistaHelpers.Fecha(Model.FechaEntrada) · @Model.UsuarioBalanzaEntrada?.NombreCompleto</dd>

            <dt class="col-sm-5">Playón</dt>
            <dd class="col-sm-7">@(Model.UsuarioPlayon?.NombreCompleto ?? "—")</dd>

            <dt class="col-sm-5">Salida</dt>
            <dd class="col-sm-7">@VistaHelpers.Fecha(Model.FechaSalida) @(Model.UsuarioBalanzaSalida != null ? "· " + Model.UsuarioBalanzaSalida.NombreCompleto : "")</dd>
        </dl>
    </div>
</div>
