@model ControlBalanza.Models.Pesaje

@{
    ViewData["Title"] = "Eliminar pesaje";
}

<h1 class="h3">Eliminar pesaje</h1>
<div class="alert alert-warning">¿Seguro que querés eliminar este pesaje? Esta acción no se puede deshacer.</div>

<partial name="_DetallePesaje" model="Model" />

<form asp-action="Delete" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</form>
