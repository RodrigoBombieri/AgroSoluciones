@model IEnumerable<ControlBalanza.Models.Pesaje>

@{
    ViewData["Title"] = "Pesajes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pesajes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo ingreso</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.NumeroCPE)</th>
                <th>@Html.DisplayNameFor(m => m.FechaEntrada)</th>
                <th>@Html.DisplayNameFor(m => m.PatenteCamion)</th>
                <th>@Html.DisplayNameFor(m => m.ProveedorId)</th>
                <th>@Html.DisplayNameFor(m => m.ProductoId)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.PesoBruto)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.PesoTara)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.PesoNeto)</th>
                <th>@Html.DisplayNameFor(m => m.Estado)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted py-4">No hay pesajes registrados.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-monospace">@item.NumeroCPE</td>
                    <td>@item.FechaEntrada.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="font-monospace">@item.PatenteCamion</td>
                    <td>@item.Proveedor?.RazonSocial</td>
                    <td>@item.Producto?.Nombre</td>
                    <td class="text-end font-monospace">@item.PesoBruto?.ToString("N0")</td>
                    <td class="text-end font-monospace">@item.PesoTara?.ToString("N0")</td>
                    <td class="text-end font-monospace">@item.PesoNeto?.ToString("N0")</td>
                    <td><span class="badge rounded-pill text-bg-secondary">@Html.DisplayFor(m => item.Estado)</span></td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id">Ver</a> |
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
