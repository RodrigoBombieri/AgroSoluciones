@model IEnumerable<Pesaje>
@{
    ViewData["Title"] = "Camiones en planta";
    var ahora = DateTime.Now;
}

<div class="page-header">
    <div>
        <h1>Camiones en planta</h1>
        <p class="subtitle">@Model.Count() camión(es) sin salida registrada, por orden de llegada.</p>
    </div>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.BalanzaEntrada))
    {
        <a asp-action="Create" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Nuevo ingreso</a>
    }
</div>

<div class="card-panel compact">
    <div class="table-responsive">
        <table class="table table-data">
            <thead>
                <tr>
                    <th>CPE</th>
                    <th>Entrada</th>
                    <th>En planta</th>
                    <th>Patente</th>
                    <th>Proveedor</th>
                    <th>Producto</th>
                    <th class="text-end">Bruto</th>
                    <th>Silo</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No hay camiones en planta.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="mono">@p.NumeroCPE</td>
                        <td>@p.FechaEntrada.ToString("dd/MM HH:mm")</td>
                        <td>@VistaHelpers.Duracion((ahora - p.FechaEntrada).TotalMinutes)</td>
                        <td class="mono">@p.PatenteCamion</td>
                        <td>@p.Proveedor?.RazonSocial</td>
                        <td>@p.Producto?.Nombre</td>
                        <td class="text-end mono">@VistaHelpers.Kg(p.PesoBruto)</td>
                        <td>@(p.SiloDestino ?? "—")</td>
                        <td><span class="estado estado-@p.Estado">@VistaHelpers.Estado(p.Estado)</span></td>
                        <td class="acciones">
                            @if (p.Estado == EstadoPesaje.ListoSalida && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.BalanzaSalida)))
                            {
                                <a asp-action="RegistrarSalida" asp-route-id="@p.Id" class="btn btn-sm btn-success">Pesar tara</a>
                            }
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
