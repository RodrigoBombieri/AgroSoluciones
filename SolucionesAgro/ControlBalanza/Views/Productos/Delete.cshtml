@model Producto
@{
    ViewData["Title"] = "Eliminar producto";
    var cantidad = (int)(ViewData["CantidadPesajes"] ?? 0);
}

<div class="page-header"><h1>Eliminar producto</h1></div>

@if (cantidad > 0)
{
    <div class="alert alert-warning">Este producto tiene @cantidad pesaje(s) registrados y no se puede eliminar.</div>
}
else
{
    <div class="alert alert-danger">¿Seguro que querés eliminar este producto?</div>
}

<div class="card-panel" style="max-width: 720px">
    <dl class="row dl-compacta mb-0">
        <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
        <dt class="col-sm-4">Variedad</dt><dd class="col-sm-8">@(Model.Variedad ?? "—")</dd>
    </dl>
</div>

<form asp-action="Delete" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    @if (cantidad == 0)
    {
        <button type="submit" class="btn btn-danger">Eliminar</button>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
</form>
