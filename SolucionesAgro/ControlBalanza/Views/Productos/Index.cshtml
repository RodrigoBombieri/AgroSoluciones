@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p class="subtitle">Granos que se reciben en planta.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><span class="material-symbols-outlined">add</span> Nuevo producto</a>
</div>

<div class="card-panel compact" style="max-width: 820px">
    <table class="table table-data">
        <thead>
            <tr><th>@Html.DisplayNameFor(m => m.Nombre)</th><th>@Html.DisplayNameFor(m => m.Variedad)</th><th></th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="3" class="text-center text-muted py-4">No hay productos.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Variedad</td>
                    <td class="acciones">
                        <a asp-action="Details" asp-route-id="@item.Id">Ver</a> ·
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> ·
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
