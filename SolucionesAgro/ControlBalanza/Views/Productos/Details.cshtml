@model Producto
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="page-header">
    <h1>@Model.Nombre</h1>
    <div class="d-flex gap-2">
        <a asp-controller="Reportes" asp-action="Index" asp-route-ProductoId="@Model.Id" class="btn btn-outline-primary">Ver pesajes</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    </div>
</div>

<div class="card-panel" style="max-width: 720px">
    <dl class="row dl-compacta mb-0">
        <dt class="col-sm-4">Variedad</dt><dd class="col-sm-8">@(Model.Variedad ?? "—")</dd>
        <dt class="col-sm-4">Pesajes registrados</dt><dd class="col-sm-8">@ViewData["CantidadPesajes"]</dd>
    </dl>
</div>
<a asp-action="Index">← Volver al listado</a>
